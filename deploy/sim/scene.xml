<!-- Sim stand-in for the real G1 + rope. Used by deploy/rope_walk.py --sim.
     The pelvis is welded to a mocap "anchor" body that we drag forward to fake walking
     (the onboard loco controller is not simulable). -->
<mujoco model="rope_walk_scene">
  <compiler meshdir="../../assets/robots/mujoco" angle="radian"/>
  <include file="../../assets/robots/mujoco/g1_unitree.xml"/>
  <statistic center="0.3 -0.2 0.8" extent="1.6"/>
  <visual>
    <global azimuth="150" elevation="-15" offwidth="1280" offheight="720"/>
    <headlight ambient="0.4 0.4 0.4"/>
  </visual>
  <asset>
    <texture type="2d" name="grid" builtin="checker" rgb1="0.25 0.3 0.35" rgb2="0.15 0.2 0.25" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="1 -2 3" dir="-0.3 0.6 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>
    <!-- rope: 6 m along +x on the robot's right; ROPE_Y / ROPE_Z are patched in by the script -->
    <geom name="rope" type="capsule" fromto="-1 -0.30 0.60  5 -0.30 0.60" size="0.008" rgba="0.9 0.2 0.1 1" contype="0" conaffinity="0"/>
    <body name="anchor" mocap="true" pos="0 0 0.79">
      <geom type="box" size="0.02 0.02 0.02" rgba="0 1 0 0.3" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <equality>
    <weld body1="anchor" body2="pelvis"/>
  </equality>
</mujoco>
